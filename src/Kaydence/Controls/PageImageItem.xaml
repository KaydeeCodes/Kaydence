<UserControl x:Class="Kaydence.Controls.PageImageItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <Grid>
        <Image x:Name="Picture" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>

        <!-- My placeholder in case a picture file ever goes missing -->
        <Border x:Name="Missing" Visibility="Collapsed" Background="{DynamicResource Brush.Hover}" CornerRadius="6">
            <TextBlock Text="Picture not found" Foreground="{DynamicResource Brush.TextMuted}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- My invisible layer that lets me drag the picture anywhere -->
        <Thumb x:Name="MoveThumb" Style="{StaticResource ClearThumb}" Cursor="SizeAll">
            <Thumb.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Rotate left" Tag="left" Click="Edit_Click"/>
                    <MenuItem Header="Rotate right" Tag="right" Click="Edit_Click"/>
                    <MenuItem Header="Crop..." Tag="crop" Click="Edit_Click"/>
                    <MenuItem Header="Reset size" Tag="reset" Click="Edit_Click"/>
                    <Separator/>
                    <MenuItem Header="Bring to front" Click="Front_Click"/>
                    <MenuItem Header="Send to back" Click="Back_Click"/>
                    <Separator/>
                    <MenuItem Header="Delete this picture" Click="Delete_Click"/>
                </ContextMenu>
            </Thumb.ContextMenu>
        </Thumb>

        <Border x:Name="Frame" Margin="-3" BorderThickness="2" CornerRadius="4"
                BorderBrush="{DynamicResource Brush.Accent}" Opacity="0" IsHitTestVisible="False"/>

        <!-- My little bin button that shows on the corner when the picture is selected -->
        <Button x:Name="DeleteButton" Style="{StaticResource BadgeButton}" Content="&#xE74D;"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-12,-12,0"
                ToolTip="Delete this picture (Delete key)" Visibility="Collapsed" Click="Delete_Click"/>

        <!-- My corner handle for resizing without squashing the picture -->
        <Thumb x:Name="ResizeThumb" Width="14" Height="14" Margin="0,0,-7,-7"
               HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Style="{StaticResource CornerThumb}" Cursor="SizeNWSE" Opacity="0"/>
    </Grid>
</UserControl>
