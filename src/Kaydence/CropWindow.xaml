<Window x:Class="Kaydence.CropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crop picture"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.UI}"
        UseLayoutRounding="True">
    <StackPanel Margin="22,20,22,20">
        <TextBlock Text="Crop picture" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="Drag over the part you want to keep. Drag inside the box to move it." Margin="0,4,0,14"
                   Foreground="{DynamicResource Brush.TextMuted}"/>

        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" HorizontalAlignment="Center">
            <Grid x:Name="Stage" Background="Transparent" Cursor="Cross"
                  MouseLeftButtonDown="Stage_MouseDown" MouseMove="Stage_MouseMove" MouseLeftButtonUp="Stage_MouseUp">
                <Image x:Name="Picture" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                <Path x:Name="Shade" Fill="#8C000000" IsHitTestVisible="False"/>
                <Rectangle x:Name="Box" Stroke="White" StrokeThickness="1.5" StrokeDashArray="4 3"
                           HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <TextBlock x:Name="SizeText" Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource Brush.TextFaint}"/>

        <DockPanel Margin="0,14,0,0">
            <Button Style="{StaticResource SoftButton}" Content="Keep it all" Click="Reset_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SoftButton}" Content="Cancel" IsCancel="True" Margin="0,0,8,0" MinWidth="90"/>
                <Button Style="{StaticResource AccentButton}" Content="Crop" IsDefault="True" MinWidth="90" Click="Crop_Click"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
