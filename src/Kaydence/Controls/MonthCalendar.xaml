<UserControl x:Class="Kaydence.Controls.MonthCalendar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- My month name with arrows to flick between months -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="MonthTitle" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                       Margin="4,0,0,0" Foreground="{DynamicResource Brush.Text}"/>
            <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11"
                    Content="&#xE76B;" Click="PrevMonth_Click" ToolTip="Previous month"/>
            <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11"
                    Content="&#xE76C;" Click="NextMonth_Click" ToolTip="Next month"/>
        </Grid>
        <UniformGrid x:Name="DayHeaders" Columns="7" Rows="1" Margin="0,0,0,4"/>
        <UniformGrid x:Name="DaysGrid" Columns="7" Rows="6"/>
    </StackPanel>
</UserControl>
