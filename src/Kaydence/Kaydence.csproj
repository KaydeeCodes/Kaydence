<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Kaydence</RootNamespace>
    <AssemblyName>Kaydence</AssemblyName>
    <ApplicationIcon>Assets\Kaydence.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Kaydence</Product>
    <Company>KaydeeCodes</Company>
    <Authors>KaydeeCodes</Authors>
    <Copyright>Copyright 2026 KaydeeCodes</Copyright>
    <Description>A private diary for Windows, made by KaydeeCodes.</Description>
  </PropertyGroup>

  <!-- I only use Windows Forms for the notification area icon, so I keep its names out of my code -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Kaydence.png" />
    <Resource Include="Assets\Kaydence.ico" />
    <Resource Include="Guide\guide.html" />
  </ItemGroup>

</Project>
