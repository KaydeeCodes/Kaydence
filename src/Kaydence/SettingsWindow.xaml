<Window x:Class="Kaydence.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kaydence settings"
        Width="920" Height="780" MinWidth="780" MinHeight="520"
        Icon="/Assets/Kaydence.ico"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.UI}"
        UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- My settings menu, each link jumps down to its section -->
        <Border Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <StackPanel Margin="14,22,14,14">
                <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" Margin="10,0,0,16" Foreground="{DynamicResource Brush.Text}"/>
                <StackPanel x:Name="Nav"/>
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="Scroller" Grid.Column="1" Style="{StaticResource PageScrollViewer}" Focusable="False"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Body" Margin="32,0,36,40" MaxWidth="780" HorizontalAlignment="Left"/>
        </ScrollViewer>
    </Grid>
</Window>
